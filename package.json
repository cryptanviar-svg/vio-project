{
  "name": "vio",
  "version": "1.6.0",
  "private": true,
  "description": "VIO — нічні та денні сесії з Fail-Safe контролем аудіовиходу",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.input.css -o tailwind.css --minify",
    "build:web": "npm run build:css && node scripts/copy-web.mjs",
    "vendor:mediapipe": "node scripts/vendor-mediapipe.mjs",
    "native:apply": "node scripts/apply-native.mjs",
    "cap:sync": "npm run build:web && npx cap sync android && npm run native:apply"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tensorflow/tfjs": "^4.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "tailwindcss": "^3.4.19"
  }
}
